# Copy to .env and fill in real values before deploying.
# Development default (no .env needed): SQLite at backend/clinixos.db

# PostgreSQL connection (docker-compose or managed Postgres).
# DATABASE_URL=postgresql+psycopg2://clinixos:CHANGE-ME@db:5432/clinixos

# REQUIRED in production: long random string for auth token signing.
# CLINIXOS_SECRET=paste-a-long-random-string-here

# Comma-separated allowed browser origins.
# CORS_ORIGINS=http://localhost:5173,http://localhost

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO

# Demo seed logins (change or disable registration in production).
# admin/admin123, reception/reception123, viewer/viewer123
